# FrameLearn 环境变量模板
# 复制为 .env 后填写真实凭据；不要提交 .env。

# ── 文字 API ─────────────────────────────────────────────────────
# 环境变量优先于 settings.toml 的 [text] 段。
# CommandParser 在 TEXT_PROVIDER + 有效 TEXT_API_KEY 同时存在时使用文字 API；
# ask 与文档生成使用同一套文本模型配置。
# provider 可选：deepseek / minimax / claude / openai / openrouter /
#   kimi / moonshot / zhipu / siliconflow / gemini / dashscope
# 所有内置 provider 都走非 Responses 协议：
#   openai_chat（/chat/completions）、anthropic（/v1/messages）、gemini。
# 当前 settings.toml 默认 provider = "claude"、model = "xxx"。
TEXT_PROVIDER=claude
TEXT_API_KEY=your_text_api_key_here
TEXT_MODEL=yourmodel
# TEXT_BASE_URL=https://api.xxx.com/anthropic

# ── 文档 Vision API ──────────────────────────────────────────────
# 环境变量优先于 settings.toml 的 [vision] 段。
# SiliconFlow provider 优先读取 SILICONFLOW_API_KEY；
# 其他 provider 读取 <PROVIDER>_API_KEY 或 VISION_API_KEY。
# VISION_PROVIDER=siliconflow
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VISION_API_KEY=your_vision_api_key_here
# VISION_BASE_URL=https://example.com/v1/

# 当前 settings.toml 默认使用 SiliconFlow Vision API，同时此 key 也用于
# asr.provider = "siliconflow" 时的 SenseVoice 转写。
SILICONFLOW_API_KEY=your_siliconflow_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/

# ── DashScope 长音频 ASR ─────────────────────────────────────────
# 当前 settings.toml 默认 asr.provider = "dashscope"。
DASHSCOPE_API_KEY=your_dashscope_key_here

# DashScope filetrans 通过签名 URL 拉取音频，因此还需要 OSS 凭据。
# Bucket、region、prefix 和 URL TTL 在 settings.toml 的 [asr.oss] 配置。
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret

# ── 在线视频下载 ─────────────────────────────────────────────────
# 下载目录与代理也可以在 settings.toml 的 [download] 配置。
# DOWNLOAD_DIR=./downloads
# DOWNLOAD_PROXY=http://127.0.0.1:7890

# B 站 Cookie（登录后复制整段 Cookie；SESSDATA 可提升画质/解锁字幕）
# BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=xxx

# YouTube Cookie：可填 cookies.txt 文件路径，或粘贴整段 Cookie
# YOUTUBE_COOKIE=/path/cookies/youtube.txt

# YouTube 原生字幕：youtube-digest 同款 Supadata API（lang=en, mode=native）
# 不配置或视频无原生英文字幕时，会回退到 yt-dlp 字幕，再回退到 ASR。
# SUPADATA_API_KEY=your_supadata_api_key_here


# 抖音 Cookie（接口风控时填写；不填时会自动尝试生成访客 Cookie）
# DOUYIN_COOKIE=ttwid=xxx; msToken=xxx

# 快手 Cookie（GraphQL 接口触发验证码时通常必需，请复制浏览器完整 Cookie）
# KUAISHOU_COOKIE=did=web_xxx; kpf=PC_WEB; kpn=KUAISHOU_VISION
