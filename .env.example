# FrameLearn 环境配置
# 复制此文件为 .env 并填入你的 API Key

# ── 文字模型（用于命令解析、文档生成、问答）────────────────────────────────
# 可选：deepseek / openai / claude / kimi / zhipu / openrouter
TEXT_PROVIDER=deepseek
TEXT_API_KEY=your_deepseek_key_here
# TEXT_MODEL=deepseek-chat        # 留空则使用默认模型
# TEXT_BASE_URL=                  # 留空则使用官方地址（自定义端点时填写）

# ── 视觉模型（用于规划 Agent、内容分析器）────────────────────────────────────
# 可选：gemini / openai / claude / openrouter
VISION_PROVIDER=gemini
VISION_API_KEY=your_gemini_key_here
# VISION_MODEL=gemini-2.0-flash   # 留空则使用默认模型
# VISION_BASE_URL=                # 留空则使用官方地址
