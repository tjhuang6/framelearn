# FrameLearn 环境配置
# 复制此文件为 .env 并填入你的 API Key

# ── 文字模型（用于命令解析、文档生成、问答）────────────────────────────────
# 可选提供商：deepseek / openai / claude / kimi / zhipu / openrouter
TEXT_PROVIDER=deepseek
TEXT_API_KEY=your_deepseek_key_here

# DeepSeek 可选模型：
#   deepseek-v4-flash    便宜快速，推荐日常使用
#   deepseek-v4-pro      最强，复杂任务
#   deepseek-r1-0528     深度推理（慢，适合复杂分析）
TEXT_MODEL=deepseek-v4-flash
# OpenAI 可选模型：
#   gpt-5.6-luna         最便宜最快（推荐日常使用）
#   gpt-5.6-terra        平衡版
#   gpt-5.6-sol          旗舰版（最强，1.05M context）
#   gpt-5.6              alias，指向 sol
# TEXT_MODEL=gpt-5.6-luna

# Claude 可选模型：
#   claude-haiku-4-5-20251001   便宜快速
#   claude-sonnet-4-20250514    平衡
# TEXT_MODEL=claude-haiku-4-5-20251001

# Kimi 可选模型：
#   moonshot-v1-8k       8k 上下文
#   moonshot-v1-32k      32k 上下文
# TEXT_MODEL=moonshot-v1-8k

# 自定义 base URL（使用代理或本地部署时填写，否则留空）
# TEXT_BASE_URL=https://your-proxy.com/v1/


# ── 视觉模型（用于规划 Agent、内容分析器，需要支持图片输入）────────────────
# 可选提供商：gemini / openai / claude / openrouter
VISION_PROVIDER=gemini
VISION_API_KEY=your_gemini_key_here

# Gemini 可选模型：
#   gemini-2.0-flash     便宜快速，推荐（支持图片）
#   gemini-2.5-pro       最强（支持图片 + 视频文件）
VISION_MODEL=gemini-2.0-flash

# OpenAI 可选模型（支持图片，全系列均可）：
#   gpt-5.6-luna         最便宜最快
#   gpt-5.6-terra        平衡版
#   gpt-5.6-sol          旗舰版（最强视觉理解，1.05M context）
#   gpt-5.6              alias，指向 sol
# VISION_MODEL=gpt-5.6-luna

# Claude 可选模型（支持图片）：
#   claude-sonnet-4-20250514
# VISION_MODEL=claude-sonnet-4-20250514

# 自定义 base URL（使用代理或本地部署时填写，否则留空）
# VISION_BASE_URL=https://your-proxy.com/v1/
